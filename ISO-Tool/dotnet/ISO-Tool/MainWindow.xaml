<Window x:Class="ISOTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ISO-Tool" Width="980" Height="680"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ISO-Tool — GitHub to Bootable ISO/Image" FontSize="24"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14"><TextBox x:Name="Repo" Width="600" Text="GitHub repository URL"/><Button Content="Analyze" Click="Analyze" Margin="8,0,0,0" Padding="18,6"/><Button Content="Build ISO" Click="Build" Margin="8,0,0,0" Padding="18,6"/></StackPanel><TextBox Grid.Row="2" x:Name="Log" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><ProgressBar Grid.Row="3" x:Name="Progress" Height="24" Margin="0,12,0,0" Minimum="0" Maximum="100"/></Grid></Window>
