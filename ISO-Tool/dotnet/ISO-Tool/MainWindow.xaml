<Window x:Class="ISOTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ISO-Tool" Width="1180" Height="820"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ISO-Tool — GitHub / Local Source → Bootable ISO/Image" FontSize="24"/><WrapPanel Grid.Row="1" Margin="0,14"><TextBox x:Name="Repo" Width="620" Text="GitHub repository URL or local checkout"/><Button x:Name="AnalyzeButton" Content="Analyze" Click="Analyze" Margin="8,0,0,0" Padding="18,6"/><Button x:Name="ImportBootButton" Content="Import Boot Sector / ISO" Click="ImportBoot" Margin="8,0,0,0" Padding="18,6"/><Button x:Name="BuildImagesButton" Content="Build Compiled Images" Click="BuildImages" Margin="8,0,0,0" Padding="18,6"/><Button x:Name="BuildButton" Content="Build ISO" Click="Build" Margin="8,0,0,0" Padding="18,6"/></WrapPanel><StackPanel Grid.Row="2"><TextBlock x:Name="BootStatus" Text="Boot validation: pending — BIOS entry 0x7C00; UEFI PE/COFF entry" Margin="0,0,0,4"/><TextBlock x:Name="Status" Text="Ready" Margin="0,0,0,6"/></StackPanel><TextBox Grid.Row="3" x:Name="Log" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas"/><ProgressBar Grid.Row="4" x:Name="Progress" Height="24" Margin="0,12,0,0" Minimum="0" Maximum="100"/></Grid></Window>
