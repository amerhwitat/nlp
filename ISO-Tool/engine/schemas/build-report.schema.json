{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ISO-Tool Build Report",
  "type":"object",
  "required":["success","stages"],
  "properties":{
    "success":{"type":"boolean"},
    "sourceCommit":{"type":"string"},
    "image":{"type":"string"},
    "sha256":{"type":"string"},
    "stages":{"type":"array","items":{"type":"object","required":["name","status"],"properties":{"name":{"type":"string"},"status":{"enum":["pending","running","success","failed","skipped"]},"durationMs":{"type":"integer"},"message":{"type":"string"}}}},
    "artifacts":{"type":"array","items":{"type":"string"}},
    "warnings":{"type":"array","items":{"type":"string"}},
    "errors":{"type":"array","items":{"type":"string"}}
  }
}
