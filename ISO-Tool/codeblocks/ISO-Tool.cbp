<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="ISO-Tool" />
		<Option pch_mode="2" />
		<Option compiler="gnu_gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/ISO-Tool.exe" prefix_auto="1" extension_auto="0" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="gnu_gcc" />
				<Compiler>
					<Add option="-std=c++17" />
					<Add option="-Wall" />
					<Add option="-Wextra" />
					<Add option="-DUNICODE" />
					<Add option="-D_UNICODE" />
				</Compiler>
				<Linker>
					<Add option="-mwindows" />
					<Add option="-municode" />
					<Add library="comctl32" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/ISO-Tool.exe" prefix_auto="1" extension_auto="0" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gnu_gcc" />
				<Compiler>
					<Add option="-std=c++17" />
					<Add option="-O2" />
					<Add option="-Wall" />
					<Add option="-Wextra" />
					<Add option="-DUNICODE" />
					<Add option="-D_UNICODE" />
				</Compiler>
				<Linker>
					<Add option="-mwindows" />
					<Add option="-municode" />
					<Add library="comctl32" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-std=c++17" />
		</Compiler>
		<Unit filename="../vcpp/ISO-Tool.cpp" />
		<Extensions>
			<code_completion />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
