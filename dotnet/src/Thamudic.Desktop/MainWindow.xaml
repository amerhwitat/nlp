<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Chimera.Thamudic.Desktop.MainWindow" Title="Chimera Ancient North Arabian NLP" Width="1100" Height="700"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Ancient North Arabian / Thamudic NLP Workbench" FontSize="24" FontWeight="Bold"/><Grid Grid.Row="1" Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Text / OCR output" FontWeight="Bold"/><TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,6"/><Button Content="Extract / Transliterate Old North Arabian" Click="Extract" Padding="8"/><TextBlock Text="Extracted" FontWeight="Bold" Margin="0,12,0,4"/><TextBox x:Name="Output" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel><GroupBox Grid.Column="1" Header="Unicode / UTF-8 Registry"><ListBox x:Name="AlphabetList" SelectionChanged="AlphabetSelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Character}" FontSize="22" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="CharacterDetails" Margin="4" TextWrapping="Wrap"/></GroupBox></Grid><TextBlock Grid.Row="2" Text="U+10A80–U+10A9F • Narb • RTL • Dadanitic encoding basis • Safaitic/Hismaic/Taymanitic/Minaic/Thamudic B variants" TextWrapping="Wrap"/></Grid></Window>
