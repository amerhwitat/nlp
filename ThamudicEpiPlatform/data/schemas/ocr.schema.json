{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThamudicEpiPlatform OCR Result",
  "type": "object",
  "required": ["engine","text","confidence","script_candidates","boxes","image_quality","warnings","source_sha256","preprocessing","provenance"],
  "properties": {
    "engine": {"type":"string"},
    "text": {"type":"string"},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "script_candidates": {"type":"array","items":{"type":"object","required":["script","score"],"properties":{"script":{"type":"string"},"score":{"type":"number","minimum":0,"maximum":1}}}},
    "boxes": {"type":"array","items":{"type":"object","required":["x","y","width","height","text","confidence"],"properties":{"x":{"type":"integer"},"y":{"type":"integer"},"width":{"type":"integer"},"height":{"type":"integer"},"text":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1}}}},
    "image_quality": {"type":"object"},
    "warnings": {"type":"array","items":{"type":"string"}},
    "source_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "preprocessing": {"type":"array","items":{"type":"string"}},
    "provenance": {"type":"object","required":["recognition_only","translation_required_review"],"properties":{"recognition_only":{"const":true},"translation_required_review":{"const":true}}}
  }
}
