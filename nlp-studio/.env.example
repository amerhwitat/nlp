# NLP / Ancient Script Studio — environment configuration.
# Copy to .env (or export these) before launch. All values are optional.

# ---- Optional remote translation provider hook -------------------------------
# The offline OCIANA corpus is always available. The remote hook is ONLY enabled
# when ANCIENT_TRANSLATION_API_KEY is non-empty. Leave blank for a fully offline app.
ANCIENT_TRANSLATION_API_KEY=
# Any OpenAI-compatible chat-completions endpoint (or your own). Defaults to the
# public OpenAI endpoint if left blank but a key is set.
ANCIENT_TRANSLATION_API_URL=
ANCIENT_TRANSLATION_MODEL=

# ---- Upload limits -----------------------------------------------------------
# Maximum upload size in bytes (default 10 MB).
NLP_STUDIO_MAX_UPLOAD_BYTES=10485760

# ---- CORS --------------------------------------------------------------------
# Comma-separated extra allowed origins. Defaults cover localhost dev + sandbox.
NLP_STUDIO_CORS_ORIGINS=

# ---- Server ------------------------------------------------------------------
PORT=8000
